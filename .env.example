# Update YOUR_POSTGRES_PASSWORD to the password for your local PostgreSQL user.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/retaildb

# Replace this with a long random value before using the app beyond local development.
SECRET_KEY=replace-this-with-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Used only when the users table is empty. Change this password after first login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_EMAIL=admin@example.com
